<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvPwdTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPwdWarn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/pwd_tip"
        android:textColor="@color/danger_red"
        android:textSize="10sp" />

    <LinearLayout
        android:id="@+id/dotsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/dot0" style="@style/PwdDot" />
        <TextView android:id="@+id/dot1" style="@style/PwdDot" android:layout_marginStart="14dp" />
        <TextView android:id="@+id/dot2" style="@style/PwdDot" android:layout_marginStart="14dp" />
        <TextView android:id="@+id/dot3" style="@style/PwdDot" android:layout_marginStart="14dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPwdMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/danger_red"
        android:textSize="12sp" />

    <GridLayout
        android:id="@+id/keypad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="14dp"
        android:columnCount="3">

        <TextView style="@style/KeypadKey" android:text="1" />
        <TextView style="@style/KeypadKey" android:text="2" />
        <TextView style="@style/KeypadKey" android:text="3" />
        <TextView style="@style/KeypadKey" android:text="4" />
        <TextView style="@style/KeypadKey" android:text="5" />
        <TextView style="@style/KeypadKey" android:text="6" />
        <TextView style="@style/KeypadKey" android:text="7" />
        <TextView style="@style/KeypadKey" android:text="8" />
        <TextView style="@style/KeypadKey" android:text="9" />
        <TextView android:id="@+id/keyClear" style="@style/KeypadKey" android:textSize="12sp" android:text="@string/btn_clear" />
        <TextView style="@style/KeypadKey" android:text="0" />
        <TextView android:id="@+id/keyDel" style="@style/KeypadKey" android:text="@string/btn_del" />
    </GridLayout>
</LinearLayout>
